{
  "manifest_version": 3,
  "name": "图片审计",
  "version": "1.0.0",
  "description": "抓取并审计当前页面中的所有图片资源",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "图片审计"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}